test "alternative MsgID 49 response is not capped by HM"

constraint p16f1847

load boiler.stc
# Boiler reports CH bounds max=75 (0x4B), min=20 (0x14)

Thermostat.mode = off

go 1500000
clearalttable
Serial.tx = "HM=60\r"
Serial.tx = "AA=49\r"
Serial.tx = "MI=120\r"

go 3000000
check {HM: 60}
check {AA: 49}

# Boiler response to gateway's alternative request should NOT be capped
go 6000000
check {B[4C]0314B14}
check {A[4C]031....} ""

# When thermostat connects and requests MsgID 49, response MUST be capped to 60 (0x3C)
mark
Thermostat.mode = ot
Thermostat.tx = 0x80310000
Thermostat.interval = 0.15

go 12000000
check {Thermostat connected}
check {T[08]0310000}
check {B[4C]0314B14}
check {A[4C]0313C14}

